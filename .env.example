# Supabase project URL and keys (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS -- never expose this to a browser client.
SUPABASE_SERVICE_ROLE_KEY=

# Must match the `vector(n)` dimension in supabase/migrations/0001_init_memory_schema.sql
EMBEDDING_DIMENSIONS=1536

# OpenRouter -- powers both the conversation loop's chat completions and its
# embeddings (openai/text-embedding-3-small via OpenRouter's OpenAI-compatible
# /embeddings endpoint, matching EMBEDDING_DIMENSIONS above), so this one key
# is all `npm run chat` needs.
# MODEL is deliberately not defaulted: the build plan's Experiment Protocol
# compares persistent-memory behavior across models, so pick one explicitly,
# e.g. a model slug from https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# OpenAI -- Realtime API only (voice, gpt-realtime-2.1). Separate from
# OpenRouter on purpose: OpenRouter doesn't proxy realtime/streaming
# voice-to-voice sessions, only discrete request/response models.
# Not currently used -- realtimeVoice.ts is dormant, no account funded yet.
OPENAI_API_KEY=

# Groq -- transcription (Whisper Large v3 Turbo) and TTS (Orpheus). Not on
# OpenRouter, needs its own key. Free tier covers personal use (20 req/min +
# 28,800 audio-sec/day for Whisper; 10 req/min + 3,600 tokens/day for
# Orpheus) -- kept as a free fallback voice pipeline. Deepgram
# (transcription.ts) and local Piper (piperTts.ts) stay in the codebase as
# further fallbacks if Groq's free tier ever isn't enough.
GROQ_API_KEY=

# xAI -- Voice Agent API (realtime, WebSocket, $0.05/min). This is the active
# voice pipeline as of writing: XAI_VOICE_AGENT_ID points at "Sophie", a
# persona built in xAI's Voice Agent Builder console -- her instructions,
# voice, and tools live server-side on xAI's account, not in this repo. See
# src/llm/xaiVoice.ts.
XAI_API_KEY=
XAI_VOICE_AGENT_ID=
