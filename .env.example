# Supabase project URL and keys (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS -- never expose this to a browser client.
SUPABASE_SERVICE_ROLE_KEY=

# Must match the `vector(n)` dimension in supabase/migrations/0001_init_memory_schema.sql
EMBEDDING_DIMENSIONS=1536
