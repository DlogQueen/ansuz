# Supabase project URL and keys (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS -- never expose this to a browser client.
SUPABASE_SERVICE_ROLE_KEY=

# Must match the `vector(n)` dimension in supabase/migrations/0001_init_memory_schema.sql
EMBEDDING_DIMENSIONS=1536

# OpenRouter -- the only LLM provider this project uses: chat completions,
# embeddings (openai/text-embedding-3-small via OpenRouter's OpenAI-compatible
# /embeddings endpoint, matching EMBEDDING_DIMENSIONS above), and the model
# catalog behind the web UI's model dropdown (GET /api/models). One key
# covers all of it.
# MODEL is the fallback used by `npm run chat` (no dropdown there) and by the
# web UI before a model's been picked -- any OpenRouter model slug, e.g. from
# https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

