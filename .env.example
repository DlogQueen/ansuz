# Supabase project URL and keys (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS -- never expose this to a browser client.
SUPABASE_SERVICE_ROLE_KEY=

# Must match the `vector(n)` dimension in supabase/migrations/0001_init_memory_schema.sql
EMBEDDING_DIMENSIONS=1536

# OpenRouter -- powers both the conversation loop's chat completions and its
# embeddings (openai/text-embedding-3-small via OpenRouter's OpenAI-compatible
# /embeddings endpoint, matching EMBEDDING_DIMENSIONS above), so this one key
# is all `npm run chat` needs.
# MODEL is deliberately not defaulted: the build plan's Experiment Protocol
# compares persistent-memory behavior across models, so pick one explicitly,
# e.g. a model slug from https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Which provider the conversation loop and BMDC think through: `openrouter` or
# `groq`. Leave unset to infer from whichever key is present (OpenRouter wins
# when both are set -- wider model selection, and it's the only one of the two
# with embeddings).
#
# Groq is the free-tier path: rate-limited, but no balance to run out of, which
# is what makes it the right fallback when OpenRouter is unfunded. The tradeoff
# is real and worth knowing -- Groq serves no embeddings endpoint, so on Groq
# long-term memory falls back from semantic retrieval to recency+importance.
# Memories are still written and still recalled, just less precisely.
# GROQ_MODEL: openai/gpt-oss-120b is the strongest general model on the free
# tier (verified against the live model list); `groq/compound` also works.
LLM_PROVIDER=
GROQ_MODEL=

# Groq -- transcription (Whisper Large v3 Turbo), TTS (Orpheus), and (see
# LLM_PROVIDER above) chat completions for the conversation loop and BMDC.
# Not on OpenRouter, needs its own key. Free tier covers personal use.
GROQ_API_KEY=

# xAI -- Voice Agent API (realtime, WebSocket, $0.05/min). This is the active
# voice pipeline as of writing: XAI_VOICE_AGENT_ID points at "Sophie", a
# persona built in xAI's Voice Agent Builder console -- her instructions,
# voice, and tools live server-side on xAI's account, not in this repo. See
# src/llm/xaiVoice.ts.
XAI_API_KEY=
XAI_VOICE_AGENT_ID=

# ---------------------------------------------------------------------------
# BMDC (Byte Me Dev Crew) -- the agentic sales crew. See docs/bmdc.md.
# ---------------------------------------------------------------------------

# Public HTTPS base URL this server is reachable at (an ngrok/cloudflared
# tunnel in development). Two things depend on it, both security-relevant:
# Twilio's webhook signature is computed over the exact URL it called, and
# Stripe checkout success/cancel URLs are built from it.
BMDC_PUBLIC_URL=

# Twilio -- SMS/WhatsApp outreach and inbound replies.
# Point the number's "A message comes in" webhook at
# {BMDC_PUBLIC_URL}/api/twilio/inbound (HTTP POST).
#
# TWILIO_ACCOUNT_SID is the AC... sid from the Console dashboard. It is ALWAYS
# required -- it's part of the REST path (/Accounts/{AC...}/Messages.json) even
# when you authenticate with an API key. An SK... value here is an API key sid,
# not an account sid, and belongs in TWILIO_API_KEY_SID below.
TWILIO_ACCOUNT_SID=
#
# Authentication, pick one:
#   (a) API key pair (SK... + secret) -- preferred. Scoped, and revocable
#       without rotating the account's auth token.
#   (b) TWILIO_AUTH_TOKEN -- the account's root credential.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
#
# TWILIO_AUTH_TOKEN is ALSO required for inbound webhooks even if you use an
# API key for sending: Twilio signs webhook requests with the account auth
# token, and an API key secret cannot verify that signature. Without it the
# server rejects every inbound message -- including STOP, which means opt-outs
# would never register. Sending works with an API key alone; receiving does not.
TWILIO_AUTH_TOKEN=
#
# TWILIO_MESSAGING_SERVICE_SID is optional but preferred for SMS: a Messaging
# Service handles sender pools and carrier-level opt-out on Twilio's side.
# Set it OR TWILIO_FROM_NUMBER (E.164, e.g. +15551234567).
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Stripe -- payment links, checkout sessions, and the webhook that books a
# sale. Add an endpoint at {BMDC_PUBLIC_URL}/api/stripe/webhook subscribed to
# checkout.session.completed; STRIPE_WEBHOOK_SECRET is that endpoint's signing
# secret (whsec_...), not the API key. Use test keys (sk_test_...) until the
# crew's behaviour is something you'd want charging real cards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Adapt-loop interval in minutes. Unset/0 = off, and off is the default: a
# cycle spends model credits and sends real messages to real people, so it
# should be something you turned on deliberately. Run cycles by hand with
# `npm run bmdc -- cycle` until you're happy with what it does.
BMDC_CYCLE_MINUTES=
